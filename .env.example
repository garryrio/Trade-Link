# ============================================
# TradeLink - contoh environment variables
# Copy file ini jadi `.env.local` lalu isi nilainya.
#   Copy-Item .env.example .env.local
# ============================================

# --- Asisten AI (Gemini) ---
# Ambil API key gratis di: https://aistudio.google.com/apikey
# JANGAN pakai prefix NEXT_PUBLIC_, key ini harus tetap di server.
GEMINI_API_KEY=

# Model yang dipakai. Default: gemini-3.8-flash
# Alternatif lebih murah/cepat: gemini-3.6-flash, gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.1-flash-lite

# Tingkat "thinking" model: low | medium | high
# low = paling cepat, cocok untuk chat. medium = default Google.
GEMINI_THINKING_LEVEL=low
